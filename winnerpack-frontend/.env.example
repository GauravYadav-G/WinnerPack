# ─────────────────────────────────────────────────────────────────────────────
# WinnerPack Frontend — environment variables
# Copy this file to .env.local and fill in the values before running.
# ─────────────────────────────────────────────────────────────────────────────

# URL of the Express backend (winnerpack-backend)
# Local dev:  http://localhost:4000
# Production: https://your-backend.up.railway.app
NEXT_PUBLIC_API_URL=http://localhost:4000

# Secret token used to secure on-demand revalidation. Set to a matching long random string on both.
REVALIDATE_SECRET=your_secure_revalidation_token_here
NEXT_PUBLIC_REVALIDATE_SECRET=your_secure_revalidation_token_here
